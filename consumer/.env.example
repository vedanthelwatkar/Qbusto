# QBusto Consumer configuration. VITE_* values are baked in at build time; rebuild after changing one.

# Backend server root, with no path - request paths already include /api.
VITE_API_URL=http://localhost:4000

# Dev-server and preview port. Fixed, so a clash fails loudly instead of moving to an origin CORS would reject.
PORT=5173

# test | sandbox | prod | production. MUST match each cinema's payment_gateway_config.environment or checkout never opens.
VITE_CASHFREE_MODE=test
