# QBusto Consumer ordering app - environment configuration
#
# Copy this file to `.env` and set the value for your environment.
# Vite reads .env files at startup only: after changing a value you must
# restart `npm run dev`, or rebuild for a production deployment.
#
# Note that VITE_ variables are inlined into the client bundle at build time
# and are therefore public. Never place a secret in this file.

# Origin of the QBusto backend - scheme, host and port, with no path and no
# trailing slash. The application appends its own paths (/api/consumer/*), so a
# value ending in /api produces /api/api/... and will 404.
#
# Product, category and banner images are served from this origin as well when
# staff uploaded them rather than linking an external URL, so this value must be
# reachable from the customer's phone, not only from the venue network.
#
# Development: http://localhost:4567
# Production:  the public HTTPS origin of the backend
VITE_API_URL=http://localhost:4567

# Port the dev server (and `npm run preview`) listens on.
# Default: 5173. Each frontend uses a different port so all three can run
# at once: Consumer 5173, Dashboard 5174, Kitchen 5175.
#
# The port is fixed rather than auto-shifting: if it is already in use the
# server fails to start instead of quietly moving to another port, which would
# put the app on an origin the backend's CORS list does not allow.
PORT=5173

# Which Cashfree environment the checkout SDK loads: sandbox | production.
#
# This MUST match the environment the backend creates payment sessions in
# (CASHFREE_ENVIRONMENT there). The session id is issued by one environment and
# is meaningless to the other, so a mismatch does not warn or fall back - the
# checkout simply never opens, on an otherwise healthy-looking build.
#
# Defaults to `sandbox` when unset, deliberately: an omitted value must never
# be the one that takes real money.
#
# Development: sandbox   (backend CASHFREE_ENVIRONMENT=test|sandbox)
# Production:  production (backend CASHFREE_ENVIRONMENT=prod|production)
VITE_CASHFREE_MODE=sandbox
