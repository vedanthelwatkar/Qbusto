// QBusto V1 Database Schema
// Source of truth: backend/docs/schema.md
// Import at: https://dbdiagram.io
// 21 active V1 tables - source_discounts, price_change_logs, user_login_logs are NOT included (deferred)

// ─── TENANCY ────────────────────────────────────────────────────────────────

Table chains {
  id         int          [pk, increment]
  name       varchar(100) [not null]
  is_active  bit          [not null, default: 1]
  created_at datetime2    [not null]
  updated_at datetime2    [not null]
}

Table cinemas {
  id         int          [pk, increment]
  chain_id   int          [not null]
  code       varchar(10)  [not null, unique, note: 'QBusto-owned cinema code used in QR URLs. NOT the external POS cinema ID - that lives on pos_integrations.external_cinema_id.']
  name       varchar(100) [not null]
  location   varchar(255)
  is_active  bit          [not null, default: 1]
  created_at datetime2    [not null]
  updated_at datetime2    [not null]
}

Table screens {
  id         int         [pk, increment]
  cinema_id  int         [not null]
  name       varchar(50) [not null]
  is_active  bit         [not null, default: 1]
  created_at datetime2   [not null]
  updated_at datetime2   [not null]
}

// ─── CATALOG (CHAIN-SCOPED) ──────────────────────────────────────────────────

Table categories {
  id          int           [pk, increment]
  chain_id    int           [not null]
  name        varchar(200)  [not null]
  description nvarchar(max)
  image_url   varchar(500)
  is_active   bit           [not null, default: 1]
  created_at  datetime2     [not null]
  updated_at  datetime2     [not null]
}

Table products {
  id               int           [pk, increment]
  chain_id         int           [not null]
  category_id      int           [not null]
  name             varchar(200)  [not null]
  description      nvarchar(max)
  weight           varchar(50)
  image_url        varchar(500)
  tax_slab_code    varchar(20)
  is_complementary bit           [not null, default: 0, note: 'Legacy field. No V1 behavior.']
  is_addon         bit           [not null, default: 0]
  addon_parent_id  int           [note: 'Self-reference: parent product for add-ons. Nullable.']
  is_active        bit           [not null, default: 1]
  created_at       datetime2     [not null]
  updated_at       datetime2     [not null]
}

// ─── CATALOG (CINEMA-SCOPED) ─────────────────────────────────────────────────

Table cinema_categories {
  id          int       [pk, increment]
  cinema_id   int       [not null]
  category_id int       [not null]
  sequence    int       [not null, default: 0]
  is_active   bit       [not null, default: 1]
  created_at  datetime2 [not null]
  updated_at  datetime2 [not null]

  indexes {
    (cinema_id, category_id) [unique, name: 'UQ_cinema_categories']
  }
}

Table cinema_products {
  id         int       [pk, increment]
  cinema_id  int       [not null]
  product_id int       [not null]
  sequence   int       [not null, default: 0]
  is_active  bit       [not null, default: 1]
  created_at datetime2 [not null]
  updated_at datetime2 [not null]

  indexes {
    (cinema_id, product_id) [unique, name: 'UQ_cinema_products']
  }
}

Table product_pricing {
  id               int           [pk, increment]
  cinema_id        int           [not null]
  product_id       int           [not null]
  day_of_week      tinyint       [not null, default: 0, note: '0=default/all days, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun. Backend tries specific day first, falls back to 0.']
  base_price       decimal(10,2) [not null]
  discount_type    char(1)       [note: 'P=percent, F=flat. Nullable.']
  discount_value   decimal(10,2)
  complement_price decimal(10,2) [note: 'Legacy field. No V1 behavior.']
  is_active        bit           [not null, default: 1]
  created_at       datetime2     [not null]
  updated_at       datetime2     [not null]

  indexes {
    (cinema_id, product_id, day_of_week) [unique, name: 'UQ_product_pricing']
  }
}

// ─── STATUS MASTER TABLES (SYSTEM-GLOBAL) ───────────────────────────────────

Table order_statuses {
  id          int          [pk, increment]
  code        varchar(30)  [not null, unique, note: 'Stable machine-readable identifier. App logic depends on code, NEVER on numeric id. Seeded values: initiated | confirmed | preparing | ready | delivered | rejected']
  name        varchar(100) [not null, note: 'Display-friendly label. Can change without breaking app logic.']
  description varchar(255)
  is_active   bit          [not null, default: 1]
  created_at  datetime2    [not null]
  updated_at  datetime2    [not null]
}

Table payment_statuses {
  id          int          [pk, increment]
  code        varchar(30)  [not null, unique, note: 'Stable machine-readable identifier. App logic depends on code, NEVER on numeric id. Seeded values: pending | paid | failed | refunded']
  name        varchar(100) [not null]
  description varchar(255)
  is_active   bit          [not null, default: 1]
  created_at  datetime2    [not null]
  updated_at  datetime2    [not null]
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

Table orders {
  id                   int           [pk, increment]
  cinema_id            int           [not null]
  screen_id            int           [note: 'Nullable - counter/kiosk orders may not be screen-specific.']
  seat_number          varchar(20)
  status_id            int           [not null, note: 'FK → order_statuses. App sets via cached statusMap[code].']
  source               varchar(20)   [note: 'qr | seat_qr | kiosk | counter']
  customer_mobile      varchar(15)
  customer_email       varchar(200)
  film_title           varchar(200)  [note: 'Provider-neutral display snapshot at order time.']
  show_time            datetime2     [note: 'Provider-neutral display snapshot at order time.']
  subtotal             decimal(10,2) [not null]
  discount             decimal(10,2) [not null, default: 0]
  total                decimal(10,2) [not null]
  payment_status_id    int           [not null, note: 'FK → payment_statuses. Independent of order status.']
  razorpay_order_id    varchar(100)
  razorpay_payment_id  varchar(100)
  razorpay_signature   varchar(255)
  notes                varchar(500)
  delivered_at         datetime2
  created_at           datetime2     [not null]
  updated_at           datetime2     [not null]
}

Table order_items {
  id           int           [pk, increment]
  order_id     int           [not null]
  product_id   int           [not null]
  product_name varchar(200)  [not null, note: 'Snapshot of product name at time of order. Preserved even if product is renamed.']
  pos_item_id  varchar(50)   [note: 'Snapshot of external POS item ID resolved at order time from product_pos_mappings. Nullable - counter/no-POS orders may lack this.']
  quantity     int           [not null]
  unit_price   decimal(10,2) [not null, note: 'Snapshot price at order time.']
  discount     decimal(10,2) [not null, default: 0]
  total        decimal(10,2) [not null]
}

// ─── STATUS AUDIT LOGS ───────────────────────────────────────────────────────

Table order_status_logs {
  id                  int          [pk, increment]
  order_id            int          [not null]
  previous_status_id  int          [note: 'NULL on first entry (order creation). FK → order_statuses.']
  new_status_id       int          [not null, note: 'FK → order_statuses.']
  changed_by_user_id  int          [note: 'NULL for system-generated transitions (e.g. payment confirmation). FK → users.']
  reason              varchar(500)
  created_at          datetime2    [not null]

  Note: 'UPDATE orders.status_id + INSERT here must occur in the SAME database transaction.'
}

Table payment_status_logs {
  id                  int          [pk, increment]
  order_id            int          [not null]
  previous_status_id  int          [note: 'NULL on first entry. FK → payment_statuses.']
  new_status_id       int          [not null, note: 'FK → payment_statuses.']
  changed_by_user_id  int          [note: 'NULL for system/webhook-driven transitions. FK → users.']
  razorpay_payment_id varchar(100) [note: 'Razorpay reference for this transition (e.g. pay_ABC on pending→paid).']
  reason              varchar(500)
  created_at          datetime2    [not null]

  Note: 'UPDATE orders.payment_status_id + INSERT here must occur in the SAME database transaction.'
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

Table users {
  id            int          [pk, increment]
  chain_id      int          [not null]
  cinema_id     int          [note: 'NULL for owner and chain_admin roles. Must belong to chain_id - validated in app code.']
  role          varchar(20)  [not null, note: 'owner | chain_admin | cinema_admin | kitchen_staff']
  username      varchar(50)  [not null, unique]
  password_hash varchar(255) [not null]
  first_name    varchar(50)
  last_name     varchar(50)
  mobile        varchar(15)
  is_active     bit          [not null, default: 1]
  created_at    datetime2    [not null]
  updated_at    datetime2    [not null]
}

// ─── CONTENT ──────────────────────────────────────────────────────────────────

Table banners {
  id         int          [pk, increment]
  cinema_id  int          [not null]
  image_url  varchar(500) [not null]
  type       char(1)      [note: 'H or I. Legacy field - semantics unconfirmed. Not blocking V1.']
  is_active  bit          [not null, default: 1]
  created_at datetime2    [not null]
  updated_at datetime2    [not null]
}

// ─── POS INTEGRATION LAYER ───────────────────────────────────────────────────

Table pos_integrations [note: 'FILTERED UNIQUE INDEX (SQL Server only - cannot be expressed in DBML): CREATE UNIQUE INDEX UQ_pos_integrations_active_cinema ON pos_integrations(cinema_id) WHERE is_active = 1. Enforces at most ONE active POS per cinema.'] {
  id                  int           [pk, increment]
  cinema_id           int           [not null]
  provider            varchar(30)   [not null, note: 'vista | showbizz | future providers']
  external_cinema_id  varchar(50)   [not null, note: 'Cinema identifier used by the external POS provider. Vista: Cinema_strID. Showbizz: TheatreId.']
  is_active           bit           [not null, default: 1]
  credential_ref      varchar(200)  [note: 'Pointer to external secrets manager (e.g. "pos/showbizz/cinema-1074"). NULL = use provider-wide env vars. Actual secrets are NEVER stored in the DB.']
  config              nvarchar(max) [note: 'Non-secret JSON config only. Example: {"api_base_url": "...", "transaction_type": "InCinemaFB", "timeout_ms": 30000}']
  created_at          datetime2     [not null]
  updated_at          datetime2     [not null]

  indexes {
    (cinema_id, provider) [unique, name: 'UQ_pos_integrations_cinema_provider']
  }
}

Table screen_pos_mappings {
  id                 int         [pk, increment]
  pos_integration_id int         [not null]
  screen_id          int         [not null]
  external_screen_id varchar(50) [not null]
  created_at         datetime2   [not null]
  updated_at         datetime2   [not null]

  indexes {
    (pos_integration_id, screen_id) [unique, name: 'UQ_screen_pos_mappings']
  }
}

Table product_pos_mappings {
  id                 int         [pk, increment]
  pos_integration_id int         [not null]
  product_id         int         [not null]
  external_item_id   varchar(50) [not null, note: 'POS item identifier. Vista: master_item_code (e.g. "I000001624"). Showbizz: ItemId.']
  external_group_id  varchar(50) [note: 'Showbizz MainItemId (parent/group concept). Nullable - Vista does not use this.']
  created_at         datetime2   [not null]
  updated_at         datetime2   [not null]

  indexes {
    (pos_integration_id, product_id) [unique, name: 'UQ_product_pos_mappings', note: 'V1 assumes 1:1 product-to-POS-item mapping per integration.']
  }
}

Table order_pos_context {
  id                  int          [pk, increment]
  order_id            int          [not null, unique, note: 'Exactly one POS context per order.']
  pos_integration_id  int          [not null]
  external_session_id varchar(100) [note: 'Vista: Session_lngSessionId. Showbizz: BookingId.']
  external_film_id    varchar(50)  [note: 'Vista: Film_strCode. Showbizz: FilmId.']
  external_screen_id  varchar(50)
  created_at          datetime2    [not null]

  Note: 'Immutable after creation. Created at order time; never updated. No updated_at column.'
}

Table pos_transactions {
  id                   int           [pk, increment]
  order_id             int           [not null]
  pos_integration_id   int           [not null]
  operation            varchar(30)   [not null, note: 'Showbizz: book_items | buy_item | cancel | refund. Vista: post_sale (inferred) | refund (unconfirmed).']
  idempotency_key      varchar(100)  [not null, unique, note: 'Format: order_{id}_{operation}. Same key on every retry. UNIQUE prevents duplicate internal rows - does NOT guarantee the external POS processes only once.']
  status               varchar(20)   [not null, default: 'pending', note: 'pending=in-flight. success=POS confirmed. failed=POS rejected (safe to retry). unknown=ambiguous outcome - do NOT blindly retry.']
  attempt_count        int           [not null, default: 1]
  external_response_id varchar(100)
  request_payload      nvarchar(4000) [note: 'Sanitized JSON of latest attempt. NEVER store passwords, tokens, or PII.']
  response_payload     nvarchar(4000) [note: 'Sanitized JSON of latest attempt.']
  last_error           varchar(500)
  last_attempted_at    datetime2
  created_at           datetime2     [not null]
  updated_at           datetime2     [not null]
}

// ─── RELATIONSHIPS ────────────────────────────────────────────────────────────

// Tenancy
Ref: cinemas.chain_id        > chains.id
Ref: screens.cinema_id       > cinemas.id
Ref: users.chain_id          > chains.id
Ref: users.cinema_id         > cinemas.id
Ref: banners.cinema_id       > cinemas.id

// Catalog - chain ownership
Ref: categories.chain_id     > chains.id
Ref: products.chain_id       > chains.id
Ref: products.category_id    > categories.id
Ref: products.addon_parent_id > products.id  // self-reference: add-on → parent product

// Catalog - cinema availability
Ref: cinema_categories.cinema_id   > cinemas.id
Ref: cinema_categories.category_id > categories.id
Ref: cinema_products.cinema_id     > cinemas.id
Ref: cinema_products.product_id    > products.id
Ref: product_pricing.cinema_id     > cinemas.id
Ref: product_pricing.product_id    > products.id

// Orders - core
Ref: orders.cinema_id         > cinemas.id
Ref: orders.screen_id         > screens.id
Ref: orders.status_id         > order_statuses.id
Ref: orders.payment_status_id > payment_statuses.id

// Order items
Ref: order_items.order_id   > orders.id
Ref: order_items.product_id > products.id

// Order status audit log
Ref: order_status_logs.order_id           > orders.id
Ref: order_status_logs.previous_status_id > order_statuses.id
Ref: order_status_logs.new_status_id      > order_statuses.id
Ref: order_status_logs.changed_by_user_id > users.id

// Payment status audit log
Ref: payment_status_logs.order_id           > orders.id
Ref: payment_status_logs.previous_status_id > payment_statuses.id
Ref: payment_status_logs.new_status_id      > payment_statuses.id
Ref: payment_status_logs.changed_by_user_id > users.id

// POS integration layer
Ref: pos_integrations.cinema_id            > cinemas.id
Ref: screen_pos_mappings.pos_integration_id > pos_integrations.id
Ref: screen_pos_mappings.screen_id          > screens.id
Ref: product_pos_mappings.pos_integration_id > pos_integrations.id
Ref: product_pos_mappings.product_id         > products.id
Ref: order_pos_context.order_id             > orders.id
Ref: order_pos_context.pos_integration_id   > pos_integrations.id
Ref: pos_transactions.order_id              > orders.id
Ref: pos_transactions.pos_integration_id    > pos_integrations.id
