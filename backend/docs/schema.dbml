// QBusto V1 Database Schema
// Source of truth: backend/docs/schema.md
// Import at: https://dbdiagram.io
// 29 active tables (including idempotency_keys from Phase 1 consumer API,
// payment_webhook_events from the payment webhook work, and offers from the
// coupon feature)
// REMOVED 2026-09-04 by 20260904000100-session-sole-show-source.js:
//   film, shows, session_old. `session` is now the single source of showtimes.
// NOT included (deferred): source_discounts, price_change_logs, user_login_logs

// Core foreign keys use ON DELETE NO ACTION and ON UPDATE NO ACTION unless stated otherwise.
// Tenant consistency for cinema-scoped rows is enforced in application code, not by DB constraints.

Table chains [note: 'Audit-user links use nullable FKs to users.id and ON DELETE SET NULL.'] {
  id                 int           [pk, increment]
  name               varchar(100)  [not null]
  logo_image_url     varchar(500)
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]
}

Table cinemas [note: 'Cinema-level notification preferences live here.'] {
  id                 int           [pk, increment]
  chain_id           int           [not null]
  code               varchar(10)   [not null, unique, note: 'QBusto-owned cinema code used in QR URLs. Not the external POS cinema id.']
  name               varchar(100)  [not null]
  location           varchar(255)
  city               varchar(100)
  gst_number         varchar(50)
  fssai_number       varchar(50)
  screensaver_url     varchar(500)  [note: 'Consumer screensaver artwork. Upload path (/uploads/cinemas/...) or external URL. Required on create; nullable for cinemas that predate the field.']
  active_since       datetime2
  sms_enabled        bit           [not null, default: 0]
  whatsapp_enabled   bit           [not null, default: 0]
  offers_enabled     bit           [not null, default: 1, note: 'Gates the coupon feature; enforced server-side in coupon.service, not cosmetic']
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]
}

Table screens {
  id                 int           [pk, increment]
  cinema_id          int           [not null]
  name               varchar(50)   [not null]
  category           nvarchar(50)  [note: 'Seat class, e.g. Platinum. Supplied by the client.']
  seat_row           nvarchar(2)   [note: 'Seat-row label, e.g. A. Supplied by the client.']
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]
}

Table categories {
  id                 int           [pk, increment]
  chain_id           int           [not null]
  name               varchar(200)  [not null]
  description        nvarchar(max)
  image_url          varchar(500)
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]
}

Table cinema_categories [note: 'Application code must validate that the linked category belongs to the same chain as the cinema.'] {
  id                 int       [pk, increment]
  cinema_id          int       [not null]
  category_id        int       [not null]
  sequence           int       [not null, default: 0]
  is_active          bit       [not null, default: 1]
  created_by int       [note: 'Nullable FK to users.id.']
  updated_by int       [note: 'Nullable FK to users.id.']
  created_at         datetime2 [not null]
  updated_at         datetime2 [not null]

  indexes {
    (cinema_id, category_id) [unique, name: 'UQ_cinema_categories']
  }
}

Table products {
  id                 int           [pk, increment]
  chain_id           int           [not null]
  category_id        int           [not null]
  name               varchar(200)  [not null]
  description        nvarchar(max)
  weight             varchar(50)
  image_url          varchar(500)
  tax_slab_code      varchar(20)
  is_addon           bit           [not null, default: 0]
  addon_parent_id    int           [note: 'Self-reference to products.id. Nullable.']
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]
}

Table cinema_products [note: 'Application code must validate that the linked product belongs to the same chain as the cinema.'] {
  id                 int       [pk, increment]
  cinema_id          int       [not null]
  product_id         int       [not null]
  sequence           int       [not null, default: 0]
  available_from     datetime2
  available_until    datetime2
  is_active          bit       [not null, default: 1]
  is_all_time_favourite bit    [not null, default: 0, note: 'Membership of the fixed "All Time Favourite" section of the Consumer catalogue, per cinema. Not a category - the product keeps its own category_id as well.']
  created_by int       [note: 'Nullable FK to users.id.']
  updated_by int       [note: 'Nullable FK to users.id.']
  created_at         datetime2 [not null]
  updated_at         datetime2 [not null]

  indexes {
    (cinema_id, product_id) [unique, name: 'UQ_cinema_products']
  }
}

Table product_availability_hours {
  id                 int       [pk, increment]
  cinema_product_id  int       [not null]
  day_of_week        tinyint   [not null, note: '0=all days, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday, 7=Sunday']
  start_time         time      [not null]
  end_time           time      [not null]
  created_by int       [note: 'Nullable FK to users.id.']
  updated_by int       [note: 'Nullable FK to users.id.']
  created_at         datetime2 [not null]
  updated_at         datetime2 [not null]

  indexes {
    (cinema_product_id, day_of_week, start_time, end_time) [unique, name: 'UQ_product_availability_hours']
    (cinema_product_id, day_of_week) [name: 'IX_product_availability_hours_lookup']
  }
}

Table product_pricing {
  id                  int           [pk, increment]
  cinema_id           int           [not null]
  product_id          int           [not null]
  monday_price        decimal(10,2) [note: 'NULL = not sold that day. CHECK NULL OR >= 0']
  tuesday_price       decimal(10,2) [note: 'NULL = not sold that day']
  wednesday_price     decimal(10,2) [note: 'NULL = not sold that day']
  thursday_price      decimal(10,2) [note: 'NULL = not sold that day']
  friday_price        decimal(10,2) [note: 'NULL = not sold that day']
  saturday_price      decimal(10,2) [note: 'NULL = not sold that day']
  sunday_price        decimal(10,2) [note: 'NULL = not sold that day. Which day applies is the 06:00-06:00 business day']
  monday_discount_type       char(1)       [note: 'Monday only. P=Percentage, F=Flat Amount']
  monday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Monday only']
  monday_discount_on_qr     decimal(10,2) [note: 'Follows monday_discount_type']
  monday_discount_on_kiosk  decimal(10,2) [note: 'Follows monday_discount_type']
  monday_discount_on_seat_qr decimal(10,2) [note: 'Follows monday_discount_type']
  monday_discount_on_counter decimal(10,2) [note: 'Follows monday_discount_type']
  tuesday_discount_type       char(1)       [note: 'Tuesday only. P=Percentage, F=Flat Amount']
  tuesday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Tuesday only']
  tuesday_discount_on_qr     decimal(10,2) [note: 'Follows tuesday_discount_type']
  tuesday_discount_on_kiosk  decimal(10,2) [note: 'Follows tuesday_discount_type']
  tuesday_discount_on_seat_qr decimal(10,2) [note: 'Follows tuesday_discount_type']
  tuesday_discount_on_counter decimal(10,2) [note: 'Follows tuesday_discount_type']
  wednesday_discount_type       char(1)       [note: 'Wednesday only. P=Percentage, F=Flat Amount']
  wednesday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Wednesday only']
  wednesday_discount_on_qr     decimal(10,2) [note: 'Follows wednesday_discount_type']
  wednesday_discount_on_kiosk  decimal(10,2) [note: 'Follows wednesday_discount_type']
  wednesday_discount_on_seat_qr decimal(10,2) [note: 'Follows wednesday_discount_type']
  wednesday_discount_on_counter decimal(10,2) [note: 'Follows wednesday_discount_type']
  thursday_discount_type       char(1)       [note: 'Thursday only. P=Percentage, F=Flat Amount']
  thursday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Thursday only']
  thursday_discount_on_qr     decimal(10,2) [note: 'Follows thursday_discount_type']
  thursday_discount_on_kiosk  decimal(10,2) [note: 'Follows thursday_discount_type']
  thursday_discount_on_seat_qr decimal(10,2) [note: 'Follows thursday_discount_type']
  thursday_discount_on_counter decimal(10,2) [note: 'Follows thursday_discount_type']
  friday_discount_type       char(1)       [note: 'Friday only. P=Percentage, F=Flat Amount']
  friday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Friday only']
  friday_discount_on_qr     decimal(10,2) [note: 'Follows friday_discount_type']
  friday_discount_on_kiosk  decimal(10,2) [note: 'Follows friday_discount_type']
  friday_discount_on_seat_qr decimal(10,2) [note: 'Follows friday_discount_type']
  friday_discount_on_counter decimal(10,2) [note: 'Follows friday_discount_type']
  saturday_discount_type       char(1)       [note: 'Saturday only. P=Percentage, F=Flat Amount']
  saturday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Saturday only']
  saturday_discount_on_qr     decimal(10,2) [note: 'Follows saturday_discount_type']
  saturday_discount_on_kiosk  decimal(10,2) [note: 'Follows saturday_discount_type']
  saturday_discount_on_seat_qr decimal(10,2) [note: 'Follows saturday_discount_type']
  saturday_discount_on_counter decimal(10,2) [note: 'Follows saturday_discount_type']
  sunday_discount_type       char(1)       [note: 'Sunday only. P=Percentage, F=Flat Amount']
  sunday_discount_value      decimal(10,2) [note: 'CHECK >= 0 when present, Sunday only']
  sunday_discount_on_qr     decimal(10,2) [note: 'Follows sunday_discount_type']
  sunday_discount_on_kiosk  decimal(10,2) [note: 'Follows sunday_discount_type']
  sunday_discount_on_seat_qr decimal(10,2) [note: 'Follows sunday_discount_type']
  sunday_discount_on_counter decimal(10,2) [note: 'Follows sunday_discount_type']
  is_active           bit           [not null, default: 1]
  created_by  int           [note: 'Nullable FK to users.id.']
  updated_by  int           [note: 'Nullable FK to users.id.']
  created_at          datetime2     [not null]
  updated_at          datetime2     [not null]

  indexes {
    (cinema_id, product_id) [unique, name: 'UQ_product_pricing_cinema_product']
  }
}

Table order_statuses {
  id          int          [pk, increment]
  code        varchar(30)  [not null, unique, note: 'Stable machine-readable identifier.']
  name        varchar(100) [not null]
  description varchar(255)
  is_active   bit          [not null, default: 1]
  created_at  datetime2    [not null]
  updated_at  datetime2    [not null]
}

Table payment_statuses {
  id          int          [pk, increment]
  code        varchar(30)  [not null, unique, note: 'Stable machine-readable identifier.']
  name        varchar(100) [not null]
  description varchar(255)
  is_active   bit          [not null, default: 1]
  created_at  datetime2    [not null]
  updated_at  datetime2    [not null]
}

Table orders {
  id                  int           [pk, increment]
  cinema_id           int           [not null]
  screen_id           int           [note: 'Nullable - counter and kiosk orders may not be screen-specific.']
  seat_number         varchar(20)
  status_id           int           [not null, note: 'FK to order_statuses.id.']
  source              varchar(20)   [note: 'Allowed values: qr, seat_qr, kiosk, counter.']
  customer_mobile     varchar(15)
  customer_email      varchar(200)
  film_title          varchar(200)  [note: 'Provider-neutral display snapshot.']
  show_time           datetime2     [note: 'Provider-neutral display snapshot.']
  subtotal            decimal(10,2) [not null, note: 'CHECK >= 0']
  discount            decimal(10,2) [not null, default: 0, note: 'CHECK >= 0']
  total               decimal(10,2) [not null, note: 'CHECK >= 0']
  payment_status_id   int           [not null, note: 'FK to payment_statuses.id.']
  sms_status          varchar(20)   [note: 'Allowed values: pending, success, failed. NULL means not applicable or not enabled.']
  whatsapp_status     varchar(20)   [note: 'Allowed values: pending, success, failed. NULL means not applicable or not enabled.']
  gateway_order_id   varchar(100)
  gateway_payment_id varchar(100)
  gateway_signature  varchar(255)
  offer_id            int           [note: 'FK to offers.id. Which coupon, if any, was applied at checkout - frozen at creation.']
  notes               varchar(500)
  delivered_at        datetime2
  created_at          datetime2     [not null]
  updated_at          datetime2     [not null]

  indexes {
    (cinema_id, created_at) [name: 'IX_orders_cinema_created_at']
    (status_id) [name: 'IX_orders_status_id']
    (payment_status_id) [name: 'IX_orders_payment_status_id']
    (gateway_order_id) [unique, name: 'UX_orders_gateway_order_id', note: 'SQL Server filtered unique index: WHERE gateway_order_id IS NOT NULL. The filter is required because SQL Server treats NULLs as equal.']
  }
}

Table order_items {
  id           int           [pk, increment]
  order_id     int           [not null]
  product_id   int           [not null]
  product_name varchar(200)  [not null, note: 'Historical snapshot.']
  pos_item_id  varchar(50)   [note: 'Snapshot of external POS item identifier.']
  quantity     int           [not null, note: 'CHECK > 0']
  unit_price   decimal(10,2) [not null, note: 'CHECK >= 0']
  discount     decimal(10,2) [not null, default: 0, note: 'CHECK >= 0']
  total        decimal(10,2) [not null, note: 'CHECK >= 0']

  indexes {
    (order_id) [name: 'IX_order_items_order_id']
  }
}

Table order_status_logs {
  id                 int          [pk, increment]
  order_id           int          [not null]
  previous_status_id int          [note: 'Nullable on first entry.']
  new_status_id      int          [not null]
  changed_by_user_id int          [note: 'Nullable FK to users.id.']
  reason             varchar(500)
  created_at         datetime2    [not null]
}

Table payment_status_logs {
  id                  int          [pk, increment]
  order_id            int          [not null]
  previous_status_id  int          [note: 'Nullable on first entry.']
  new_status_id       int          [not null]
  changed_by_user_id  int          [note: 'Nullable FK to users.id.']
  gateway_payment_id varchar(100)
  reason              varchar(500)
  created_at          datetime2    [not null]
}

Table users {
  id            int          [pk, increment]
  chain_id      int          [not null]
  cinema_id     int          [note: 'Nullable for owner and chain_admin roles.']
  role          varchar(20)  [not null, note: 'Allowed values: owner, chain_admin, cinema_admin, kitchen_staff, cinema_accountant.']
  username      varchar(50)  [not null, unique]
  password_hash varchar(255) [not null]
  first_name    varchar(50)
  last_name     varchar(50)
  mobile        varchar(15)
  is_active     bit          [not null, default: 1]
  created_at    datetime2    [not null]
  updated_at    datetime2    [not null]
}

Table user_permissions {
  id                 int       [pk, increment]
  user_id            int       [not null]
  module_name        varchar(50) [not null, note: 'Allowed values: Dashboard, Orders, Products, Categories, Pricing, Banners, Users, Reports, POS Integrations, Settings.']
  can_read           bit       [not null, default: 0]
  can_edit           bit       [not null, default: 0]
  can_delete         bit       [not null, default: 0]
  created_by int       [note: 'Nullable FK to users.id.']
  updated_by int       [note: 'Nullable FK to users.id.']
  created_at         datetime2 [not null]
  updated_at         datetime2 [not null]

  indexes {
    (user_id, module_name) [unique, name: 'UQ_user_permissions']
  }
}

Table banners {
  id                 int           [pk, increment]
  cinema_id          int           [not null]
  image_url          varchar(500)  [not null]
  type               char(1)       [not null, note: 'Allowed values: H (Header), I (Inner). V1 uses Header only.']
  sequence           int           [not null, default: 0]
  start_date         datetime2
  end_date           datetime2
  is_active          bit           [not null, default: 1]
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2    [not null]
  updated_at         datetime2    [not null]
}

Table pos_integrations [note: 'SQL Server filtered unique index: one active row per cinema where is_active = 1.'] {
  id                 int           [pk, increment]
  cinema_id          int           [not null]
  provider           varchar(30)   [not null, note: 'Allowed values: vista, showbizz, impact, qbusto.']
  external_cinema_id varchar(50)   [not null, note: 'External POS cinema identifier.']
  api_url            varchar(500)  [not null]
  is_active          bit           [not null, default: 1]
  credential_ref     varchar(200)  [note: 'Pointer to external secrets storage.']
  config             nvarchar(max) [note: 'Non-secret JSON config only.']
  created_by int           [note: 'Nullable FK to users.id.']
  updated_by int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]

  indexes {
    (cinema_id, provider) [unique, name: 'UQ_pos_integrations_cinema_provider']
  }
}

Table session [note: "THE single source of showtimes. Ten columns. Composite PK. The film title is a column, not a join - there is no film table. Names its auditorium rather than referencing screens.id. Date columns are datetime, not datetime2. Written by showSync.service and by the client's own systems; read-only through the API."] {
  Code                  varchar(10)  [pk, note: 'FK to cinemas.code, not cinemas.id.']
  Session_lngSessionId  int          [pk]
  Film_strName          varchar(200) [note: 'The film title. Denormalized from the dropped film table.']
  Film_strCode          varchar(20)  [not null, note: "Provider's film code. Not a FK - there is nothing to point at."]
  Screen_bytNum         int
  Screen_strName        varchar(25)  [note: 'Auditorium by name. There is no screens.id here.']
  Session_strStatus     varchar(1)   [not null, note: "O=Open (the only status offered to customers), C=Closed, I=Inactive. An undocumented 'Y' also occurs and is never interpreted."]
  Session_dtmRealShow   datetime     [not null, note: 'Show start.']
  Session_dtmFinishShow datetime     [not null, note: 'Show end. Load-bearing: makes the current show answerable server-side.']
  Session_dtmStamp      datetime     [note: "Provider's own row timestamp."]

  indexes {
    (Code, Screen_strName, Session_dtmRealShow) [name: 'IX_session_cinema_screen_start']
  }
}

Table screen_layout [note: "The client's seat map: one row per seat. Currently empty. Identifies its screen by name, not by screens.id."] {
  id          int          [pk, increment]
  cinema_id   int          [not null]
  screen_name varchar(50)  [not null]
  category    varchar(50)  [not null]
  seat_row    varchar(2)   [not null]
  seat_no     varchar(3)   [not null]
  is_active   bit          [not null, default: 1]
  created_by  int          [note: 'Nullable FK to users.id.']
  updated_by  int          [note: 'Nullable FK to users.id.']
  created_at  datetime2    [not null]
  updated_at  datetime2    [not null]
}

Table screen_pos_mappings {
  id                 int         [pk, increment]
  pos_integration_id int         [not null]
  screen_id          int         [not null]
  external_screen_id varchar(50) [not null]
  created_by int         [note: 'Nullable FK to users.id.']
  updated_by int         [note: 'Nullable FK to users.id.']
  created_at         datetime2   [not null]
  updated_at         datetime2   [not null]

  indexes {
    (pos_integration_id, screen_id) [unique, name: 'UQ_screen_pos_mappings']
  }
}

Table product_pos_mappings {
  id                 int         [pk, increment]
  pos_integration_id int         [not null]
  product_id         int         [not null]
  external_item_id   varchar(50) [not null]
  external_group_id  varchar(50)
  created_by int         [note: 'Nullable FK to users.id.']
  updated_by int         [note: 'Nullable FK to users.id.']
  created_at         datetime2   [not null]
  updated_at         datetime2   [not null]

  indexes {
    (pos_integration_id, product_id) [unique, name: 'UQ_product_pos_mappings']
  }
}

Table order_pos_context [note: 'Immutable after creation. No updated_at column.'] {
  id                  int          [pk, increment]
  order_id            int          [not null, unique, note: 'Exactly one POS context per order.']
  pos_integration_id  int          [not null]
  external_session_id varchar(100)
  external_film_id    varchar(50)
  external_screen_id  varchar(50)
  external_booking_id varchar(100) [note: 'Implements POS_BookingId.']
  created_at          datetime2    [not null]
}

Table pos_transactions {
  id                   int           [pk, increment]
  order_id             int           [not null]
  pos_integration_id   int           [not null]
  operation            varchar(30)   [not null, note: 'Integration operation name.']
  idempotency_key      varchar(100)  [not null, unique]
  status               varchar(20)   [not null, default: 'pending', note: 'Allowed values: pending, success, failed, unknown.']
  attempt_count        int           [not null, default: 1, note: 'CHECK >= 1']
  external_response_id varchar(100)
  request_payload      nvarchar(4000)
  response_payload     nvarchar(4000)
  last_error           varchar(500)
  last_attempted_at    datetime2
  created_at           datetime2     [not null]
  updated_at           datetime2     [not null]

  indexes {
    (order_id) [name: 'IX_pos_transactions_order_id']
  }
}

Table payment_gateway_config [note: 'SQL Server filtered unique index: one active row per cinema where is_active = 1. Actively used - cashfree.client.resolveCredentials(cinemaId) reads this before falling back to the deployment-wide CASHFREE_* env vars.'] {
  id                         int           [pk, increment]
  cinema_id                  int           [not null]
  gateway_url                varchar(500)  [not null, note: 'Genuinely unused.']
  gateway_id                 varchar(255)  [not null, note: "Cashfree's APP_ID."]
  gateway_secret_encrypted   varchar(1000) [not null, note: "Cashfree's SECRET_KEY, AES-256-GCM ciphertext. Never plaintext."]
  environment                varchar(20)   [not null, default: 'test', note: "test | sandbox | prod | production, mirroring CASHFREE_ENVIRONMENT's vocabulary."]
  is_active                  bit           [not null, default: 1]
  created_by         int           [note: 'Nullable FK to users.id.']
  updated_by         int           [note: 'Nullable FK to users.id.']
  created_at                 datetime2     [not null]
  updated_at                 datetime2     [not null]
}

Table offers [note: 'Cinema-scoped coupons, managed from the Dashboard Offers tab. Validated and applied entirely within QBusto (services/coupon.service.js) - Cashfree has no visibility into this table. UX_offers_cinema_id_code: unique (cinema_id, code).'] {
  id                int           [pk, increment]
  cinema_id         int           [not null]
  code              varchar(50)   [not null, note: 'What a customer types into "Apply coupon" in the Consumer app. Unique per cinema, not globally.']
  name              varchar(150)  [not null]
  discount_type     varchar(30)   [not null, note: "Free text, but a DEFINED meaning: 'percentage' (case-insensitive) drives percent-of-cart math; anything else, including 'flat', is a flat rupee amount."]
  description       varchar(500)
  tnc               varchar(2000)
  status             varchar(20)   [not null, default: 'active', note: 'Free text, e.g. active/inactive.']
  disc_amount       decimal(10,2) [not null]
  max_disc_amount   decimal(10,2) [note: "Only meaningful when discount_type is 'percentage' - caps the discount. Ignored for a flat coupon."]
  min_txn_amount    decimal(10,2)
  max_txn_amount    decimal(10,2)
  max_txn_limit     int           [note: 'Redemption COUNT cap, not an amount. Counted only against paid orders.']
  valid_from        datetime2
  valid_until       datetime2
  created_by         int           [note: 'Nullable FK to users.id.']
  updated_by         int           [note: 'Nullable FK to users.id.']
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]

  indexes {
    (cinema_id, code) [unique, name: 'UX_offers_cinema_id_code']
  }
}

Table idempotency_keys [note: 'Maps Idempotency-Key header (UUID) to order for consumer API POST /api/consumer/orders. Unique constraint on key column prevents duplicate orders on network retries.'] {
  id                 int           [pk, increment]
  key                varchar(36)   [not null, unique, note: 'UUID v4 from Idempotency-Key header']
  order_id           int           [not null]
  created_at         datetime2     [not null]
  updated_at         datetime2     [not null]

  indexes {
    (key) [unique, name: 'IX_idempotency_keys_key']
  }
}

Table payment_webhook_events [note: 'Durable record of every Cashfree webhook delivery. Machine-written by the webhook handler; no audit-user fields. The unique event_id is the deduplication mechanism.'] {
  id                  int          [pk, increment]
  event_id            varchar(64)  [not null, unique, note: 'Cashfree sends no dedicated event-id header; the key is derived as "event:cf_payment_id", or "event:gateway_order_id" when the delivery carries no payment entity.']
  event               varchar(50)  [not null, note: 'e.g. PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK, PAYMENT_USER_DROPPED_WEBHOOK']
  gateway_order_id   varchar(50)  [note: 'From the event payload; null if the event carried none.']
  gateway_payment_id varchar(50)
  order_id            int          [note: 'Nullable FK to orders.id. Null when the event names a Cashfree order this system does not recognise - such a delivery is still recorded rather than dropped.']
  outcome             varchar(30)  [not null, note: 'received | applied | ignored']
  reason              varchar(60)  [note: 'Why an event was ignored, for investigation.']
  created_at          datetime2    [not null]
  updated_at          datetime2    [not null]

  indexes {
    (event_id) [unique, name: 'UQ_payment_webhook_events_event_id']
    (gateway_order_id) [name: 'IX_payment_webhook_events_gateway_order_id']
  }
}

