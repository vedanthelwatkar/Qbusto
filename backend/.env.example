# App
NODE_ENV=development
PORT=3000
# Base URL advertised in the OpenAPI spec. Defaults to http://localhost:$PORT
API_BASE_URL=https://api.qbusto.example

# Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
# Must be at least 32 characters in production; shorter values warn at startup.
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
JWT_ISSUER=qbusto

# Cors
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
CORS_ALLOW_CREDENTIALS=true

# Logging
# error | warn | info | http | debug. Defaults to debug outside production.
LOG_LEVEL=debug
# Directory for production log files, relative to backend/. Gitignored.
LOG_DIR=logs

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# API docs
# Serves Swagger UI at /api/docs. Consider disabling in production.
SWAGGER_ENABLED=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
