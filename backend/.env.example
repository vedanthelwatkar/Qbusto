# QBusto backend - environment configuration
#
# Copy this file to `.env` and replace every placeholder with a real value.
# All variables are validated at startup by src/config/env.js; the process
# refuses to boot if a required value is missing or malformed.
#
# Values marked "required" have no default. Everything else falls back to the
# default shown in the comment above it.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | production. Controls several production-only guards
# documented further down. Default: development
NODE_ENV=development

# Port the HTTP server listens on. Default: 4000
PORT=4000

# Absolute base URL advertised in the generated OpenAPI document. Optional;
# defaults to http://localhost:<PORT>. Set this in production so the published
# API documentation points at the real host.
API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database (Microsoft SQL Server) - required
# ---------------------------------------------------------------------------

DB_HOST=localhost
# Default: 1433
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_user
# Required, but may be an empty string for trusted local instances.
DB_PASSWORD=your_database_password

# TLS for the SQL Server connection. Default: true
DB_ENCRYPT=true
# Accept a self-signed SQL Server certificate. Default: true
# Set to false in production when the server presents a trusted certificate.
DB_TRUST_SERVER_CERTIFICATE=true

# ---------------------------------------------------------------------------
# Authentication - required
# ---------------------------------------------------------------------------

# Signing key for access tokens. Use a long random value and keep it out of
# version control.
#
# PRODUCTION: must be at least 32 characters, enforced at startup. Outside
# production a shorter value logs a warning but still boots.
JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime, as accepted by jsonwebtoken (e.g. 1d, 12h). Default: 1d
JWT_EXPIRES_IN=1d
# `iss` claim written into, and verified on, every token. Default: qbusto
JWT_ISSUER=qbusto

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API. Default: ""
#
# `*` allows every origin and is logged as a warning at startup. It is a
# development convenience only - set an explicit list before deploying.
# Development defaults below match the fixed frontend dev-server ports:
#   5173 Consumer, 5174 Dashboard, 5175 Kitchen
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Allow cookies/authorization on cross-origin requests. Default: false
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# error | warn | info | http | debug
# Default: info in production, debug elsewhere.
LOG_LEVEL=debug

# Directory for log files, relative to backend/. Default: logs
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Window length in milliseconds. Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window, per client. Default: 300
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------

# Serves Swagger UI at /api/docs and the raw document at /api/docs.json.
# Default: true. Consider disabling on a public production deployment.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Razorpay payments
# ---------------------------------------------------------------------------
# All three values are optional at startup, so the backend boots without them.
# Payment endpoints are unavailable until the key pair is configured.

# API key pair from the Razorpay Dashboard.
#
# PRODUCTION: a test key (rzp_test_...) is rejected at startup. A live key
# (rzp_live_...) outside production logs a warning.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook signing secret. This is NOT the API key secret above - Razorpay
# generates a separate value for each webhook you create under
# Settings > Webhooks, and webhook signatures verify against this one.
#
# Without it the webhook endpoint rejects every delivery rather than trusting
# unverified payment events.
#
# PRODUCTION: required, minimum 32 characters, enforced at startup.
# Server-side only - never expose it to the Consumer app.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
