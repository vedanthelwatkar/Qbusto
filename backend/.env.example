# QBusto backend configuration. Validated at boot by src/config/env.js - a missing or malformed value refuses to start.

# development | test | production. Default: development
NODE_ENV=development

# Business timezone. Verified at boot - the process refuses to start if the runtime resolves elsewhere.
APP_TIMEZONE=Asia/Kolkata

# Port the HTTP server listens on. Default: 4000
PORT=4000

# Base URL advertised in the generated OpenAPI document. Default: http://localhost:<PORT>
API_BASE_URL=http://localhost:4000

# SQL Server host. Required.
DB_HOST=localhost

# SQL Server port. Default: 1433
DB_PORT=1433

# Database name. Required.
DB_NAME=your_database_name

# Database user. Required.
DB_USER=your_database_user

# Database password. Required, but may be empty for a trusted local instance.
DB_PASSWORD=your_database_password

# TLS for the SQL Server connection. Default: true
DB_ENCRYPT=true

# Accept a self-signed certificate. Default: true - set false in production.
DB_TRUST_SERVER_CERTIFICATE=true

# Access-token signing key. Required, and at least 32 characters in production.
JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime, as jsonwebtoken accepts it (1d, 12h). Default: 1d
JWT_EXPIRES_IN=1d

# iss claim written into, and verified on, every token. Default: qbusto
JWT_ISSUER=qbusto

# Comma-separated browser origins allowed to call the API. * is a dev convenience and warns at boot.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Allow cookies/authorization on cross-origin requests. Default: false
CORS_ALLOW_CREDENTIALS=true

# error | warn | info | http | debug. Default: info in production, debug elsewhere.
LOG_LEVEL=debug

# Log directory, relative to backend/. Default: logs
LOG_DIR=logs

# Rate-limit window in milliseconds. Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window, per client. Default: 300
RATE_LIMIT_MAX=300

# Enables the public catalogue cache. Unset means no cache: every consumer request goes to SQL Server.
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://user:password@host:6380

# How long a cached catalogue response stays servable, and so the worst-case staleness. Default: 60
CACHE_TTL_SECONDS=60

# Give up on a Redis command after this long and fall back to the database. Default: 1000
REDIS_TIMEOUT_MS=1000

# Serve Swagger UI at /api/docs. Default: true - consider disabling on a public deployment.
SWAGGER_ENABLED=true

# Optional per-order webhook override. Must be HTTPS and publicly reachable.
# CASHFREE_NOTIFY_URL=https://api.example.com/api/webhooks/cashfree

# Optional hosted-checkout return URL. The Consumer also recovers on its own.
# CASHFREE_RETURN_URL=https://consumer.example.com/payment

# Used when an order carries no usable mobile. Contact metadata only, never authenticated against.
# CASHFREE_FALLBACK_CUSTOMER_PHONE=9999999999

# Maximum duration of any single Cashfree call, in milliseconds. Default: 4000
# CASHFREE_TIMEOUT_MS=4000

# 64 hex characters (32 bytes) decrypting payment_gateway_config.gateway_secret_encrypted. Required in production; rotating it orphans every stored credential.
CREDENTIALS_ENCRYPTION_KEY=

# Where uploaded images are written. Relative resolves against the repo root; use an absolute path outside the source tree in production.
FILE_STORAGE_PATH=shared/uploads

# Largest image accepted, in whole megabytes. Maximum 50.
MAX_UPLOAD_SIZE_MB=5
