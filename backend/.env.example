# QBusto backend - environment configuration
#
# Copy this file to `.env` and replace every placeholder with a real value.
# All variables are validated at startup by src/config/env.js; the process
# refuses to boot if a required value is missing or malformed.
#
# Values marked "required" have no default. Everything else falls back to the
# default shown in the comment above it.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | production. Controls several production-only guards
# documented further down. Default: development
NODE_ENV=development

# The timezone the business runs in. NOT a display preference: the client's
# session/film tables store offset-less local wall clock, and the session
# window is computed in process-local time to match. A container or cloud VM
# defaults to UTC, which would shift every show time by 5.5 hours silently.
# Verified at boot - the process refuses to start if it resolves elsewhere.
APP_TIMEZONE=Asia/Kolkata

# Port the HTTP server listens on. Default: 4000
PORT=4000

# Absolute base URL advertised in the generated OpenAPI document. Optional;
# defaults to http://localhost:<PORT>. Set this in production so the published
# API documentation points at the real host.
API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database (Microsoft SQL Server) - required
# ---------------------------------------------------------------------------

DB_HOST=localhost
# Default: 1433
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_user
# Required, but may be an empty string for trusted local instances.
DB_PASSWORD=your_database_password

# TLS for the SQL Server connection. Default: true
DB_ENCRYPT=true
# Accept a self-signed SQL Server certificate. Default: true
# Set to false in production when the server presents a trusted certificate.
DB_TRUST_SERVER_CERTIFICATE=true

# ---------------------------------------------------------------------------
# Authentication - required
# ---------------------------------------------------------------------------

# Signing key for access tokens. Use a long random value and keep it out of
# version control.
#
# PRODUCTION: must be at least 32 characters, enforced at startup. Outside
# production a shorter value logs a warning but still boots.
JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime, as accepted by jsonwebtoken (e.g. 1d, 12h). Default: 1d
JWT_EXPIRES_IN=1d
# `iss` claim written into, and verified on, every token. Default: qbusto
JWT_ISSUER=qbusto

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API. Default: ""
#
# `*` allows every origin and is logged as a warning at startup. It is a
# development convenience only - set an explicit list before deploying.
# Development defaults below match the fixed frontend dev-server ports:
#   5173 Consumer, 5174 Dashboard, 5175 Kitchen
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Allow cookies/authorization on cross-origin requests. Default: false
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# error | warn | info | http | debug
# Default: info in production, debug elsewhere.
LOG_LEVEL=debug

# Directory for log files, relative to backend/. Default: logs
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Window length in milliseconds. Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window, per client. Default: 300
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------

# Serves Swagger UI at /api/docs and the raw document at /api/docs.json.
# Default: true. Consider disabling on a public production deployment.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Cashfree payments
# ---------------------------------------------------------------------------
# Optional at startup, so the backend boots without them. Payment endpoints are
# unavailable until the credential pair is configured.
#
# There is NO separate webhook secret. Cashfree signs webhooks with the same
# secret key used to authenticate API calls, so CASHFREE_SECRET_KEY is both the
# API credential and the webhook verification key.

# Credential pair from the Cashfree Dashboard, under Developers > API Keys.
# The names match the labels the dashboard itself uses.
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key

# Which Cashfree environment to talk to: test | sandbox | prod | production.
# "test"/"sandbox" and "prod"/"production" are synonyms - Cashfree's API docs
# use one pair and its dashboard/SDK the other.
#
# PRODUCTION: NODE_ENV=production with a non-production value here is rejected
# at startup, because payments would be simulated and no money collected.
# A production value outside NODE_ENV=production logs a warning: it charges
# real cards.
CASHFREE_ENVIRONMENT=test

# Where Cashfree should POST payment notifications. Optional - the webhook URL
# is normally registered once in the Cashfree Dashboard, and this only
# overrides it per order, which is what makes a local tunnel work without
# touching shared dashboard configuration.
#
# Must be HTTPS and publicly reachable. This is what settles a payment when the
# customer never returns to the app, so a deployment without a working webhook
# can lose payments.
# CASHFREE_NOTIFY_URL=https://api.example.com/api/webhooks/cashfree

# Where the hosted checkout returns the customer. Optional; the Consumer app
# also recovers on its own when the customer comes back by any route.
# CASHFREE_RETURN_URL=https://consumer.example.com/payment

# Used when an order carries no usable mobile number. Cashfree rejects an order
# create without a 10-digit customer_phone, and orders.customer_mobile is
# nullable. Contact metadata only - never authenticated against.
# CASHFREE_FALLBACK_CUSTOMER_PHONE=9999999999

# How long any single Cashfree call may take, in milliseconds. The binding
# constraint is payment-init, which a customer is waiting on.
# CASHFREE_TIMEOUT_MS=4000

# CASHFREE_APP_ID/CASHFREE_SECRET_KEY/CASHFREE_ENVIRONMENT above are now the
# FALLBACK used only when a cinema has no active row in payment_gateway_config.
# The primary source of Cashfree credentials is per-cinema, stored encrypted
# in that table, managed from the Dashboard's Offers tab settings. See
# CREDENTIALS_ENCRYPTION_KEY below and docs/pre-production-checklist.md.

# ---------------------------------------------------------------------------
# Per-cinema payment gateway credentials
# ---------------------------------------------------------------------------
# payment_gateway_config.gateway_secret_encrypted stores each cinema's
# Cashfree secret key encrypted (AES-256-GCM). This key decrypts it, and lives
# ONLY here - never in the database. Required in production; the app throws at
# boot without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 hex characters (32 bytes). Rotating this key makes every existing
# encrypted row undecryptable - there is no re-encryption tooling yet, so
# rotate only alongside re-entering every cinema's credentials.
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Image uploads
# ---------------------------------------------------------------------------
# Banners, categories, products and the chain logo each hold a single image
# value that is either an external https:// URL or a file uploaded here.
# Uploaded files are stored on this server's filesystem; the database only ever
# holds the application path, e.g. /uploads/products/9f2c....webp.
#
# There is ONE shared storage location for the whole platform. The backend is
# the only application that touches the filesystem - the Dashboard uploads
# through POST /api/uploads/{entity}, and the Consumer and Kitchen read images
# through GET /uploads/... No frontend has its own upload directory.

# Where uploaded images are written.
#
# A relative value is resolved against the repository root, so the default
# below is <repo>/shared/uploads - the same shared directory that already holds
# the generated openapi.json - and works for local development with no
# configuration at all. openapi.json is unaffected and stays where it is.
#
# PRODUCTION: set an absolute path OUTSIDE the source tree, so that redeploying
# or re-cloning the application cannot remove customer images. The directory
# must exist, must be readable and writable by the account the backend service
# runs as, must be on persistent storage, and must be included in the server's
# backup schedule - these files exist nowhere else.
#
# Examples (choose the one that matches the server, do not copy both):
#   Linux:   FILE_STORAGE_PATH=/var/lib/qbusto/uploads
#   Windows: FILE_STORAGE_PATH=D:\qbusto\uploads
FILE_STORAGE_PATH=shared/uploads

# Largest image accepted, in megabytes. Whole number, maximum 50.
# Anything larger is rejected before it reaches the disk.
MAX_UPLOAD_SIZE_MB=5
