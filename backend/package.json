    "mssql": "^12.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0"
  }
