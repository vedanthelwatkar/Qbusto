    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^20.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
