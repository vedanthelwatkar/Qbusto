# QBusto Kitchen Display System - environment configuration
#
# Copy this file to `.env` and set the value for your environment.
# Vite reads .env files at startup only: after changing a value you must
# restart `npm run dev`, or rebuild for a production deployment.

# Origin of the QBusto backend - scheme, host and port, with no path and no
# trailing slash. The application appends its own paths (/api/auth/*,
# /api/kitchen/*), so a value ending in /api produces /api/api/... and will 404.
#
# Development: http://localhost:4567
# Production:  the address of the backend server on the venue network
VITE_API_URL=http://localhost:4567

# Port the dev server (and `npm run preview`) listens on.
# Default: 5175. Each frontend uses a different port so all three can run
# at once: Consumer 5173, Dashboard 5174, Kitchen 5175.
#
# The port is fixed rather than auto-shifting: if it is already in use the
# server fails to start instead of quietly moving to another port, which would
# put the app on an origin the backend's CORS list does not allow.
PORT=5175
